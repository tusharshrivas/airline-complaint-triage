# Copy to .env and fill in. NEVER commit .env.
# Provider: groq (default) | gemini | ollama
LLM_PROVIDER=groq
# Free key from https://console.groq.com
GROQ_API_KEY=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Local Ollama (no key). Default shown.
OLLAMA_HOST=http://localhost:11434
# Optional: override the model id from configs/providers.yaml
LLM_MODEL=
# Path to Tweets.csv if you already downloaded it (default: data/raw/Tweets.csv)
DATA_PATH=
# Optional: lets `prepare-data` download the dataset via the Kaggle REST API
KAGGLE_USERNAME=
KAGGLE_KEY=
